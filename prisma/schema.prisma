datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String    @id @default(cuid())
  userId              String?   @unique
  name                String?
  email               String    @unique
  passwordHash        String?
  recentPasswordHashes String[] @default([])
  role                String    @default("STUDENT")
  isActive            Boolean   @default(true)
  avatarUrl           String?
  bio                 String?
  phone               String?
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  emailNotifications  Boolean   @default(true)
  courseReminders     Boolean   @default(true)
  marketingEmails     Boolean   @default(false)
  securityAlerts      Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orders          Order[]
  enrollments     Enrollment[]
  savedCourses    SavedCourse[]
  lectureProgress LectureProgress[]

  @@map("users")
}

model OtpVerification {
  id                 String    @id @default(cuid())
  otpVerificationId  String?   @unique
  userId             String?
  email              String?
  phone              String?
  purpose            String
  code               String
  expiresAt          DateTime
  usedAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([email, purpose])
  @@index([phone, purpose])
  @@index([userId, purpose])
  @@map("otp_verifications")
}

model Course {
  id               String    @id @default(cuid())
  courseId         String?   @unique
  slug             String    @unique
  title            String
  shortDescription String?
  description      String
  category         String
  level            String
  durationHours    Int?
  price            Float
  offerPrice       Float?
  isPromotional    Boolean   @default(false)
  isBestValue      Boolean   @default(false)
  isNew            Boolean   @default(false)
  promoCode        String?
  currency         String    @default("INR")
  featured         Boolean   @default(false)
  isPublished      Boolean   @default(true)
  isLive           Boolean   @default(false)
  language         String    @default("en")
  imageUrl         String?
  instructorName   String
  instructorTitle  String?
  previewLectureUrl String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  modules         Module[]
  enrollments     Enrollment[]
  orders          Order[]
  savedCourses    SavedCourse[]
  lectureProgress LectureProgress[]

  @@map("courses")
}

model Module {
  id          String   @id @default(cuid())
  moduleId    String?  @unique
  courseId    String
  title       String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lectures Lecture[]

  @@index([courseId, position])
  @@map("modules")
}

model Lecture {
  id               String   @id @default(cuid())
  lectureId        String?  @unique
  moduleId         String
  title            String
  description      String?
  videoUrl         String?
  hlsUrl           String?
  durationSeconds  Int?
  isPreview        Boolean  @default(false)
  liveSessionUrl   String?
  position        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  module          Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lectureProgress LectureProgress[]

  @@index([moduleId, position])
  @@map("lectures")
}

model LectureProgress {
  id                String   @id @default(cuid())
  lectureProgressId String?  @unique
  userId            String
  courseId          String
  lectureId         String
  status            String   @default("not_started")
  watchedPercent    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
  @@index([userId, courseId])
  @@map("lecture_progress")
}

model Order {
  id                 String          @id @default(cuid())
  orderId            String?         @unique
  userId             String
  courseId           String
  amount             Float
  currency           String          @default("INR")
  status             String          @default("PENDING")
  paymentProvider    String          @default("RAZORPAY")
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  invoiceNumber      String?         @unique
  metadata           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment Enrollment?

  @@map("orders")
}

model Enrollment {
  id            String   @id @default(cuid())
  enrollmentId  String?  @unique
  userId        String
  courseId      String
  orderId       String?  @unique
  accessGranted  Boolean  @default(true)
  grantedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("enrollments")
}

model SavedCourse {
  id            String   @id @default(cuid())
  savedCourseId String?  @unique
  userId        String
  courseId      String
  createdAt     DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("saved_courses")
}
